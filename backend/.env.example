# ============================================================
#  .env  —  Local development environment variables
#  DO NOT commit this file to version control!
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/procure_db
DB_USERNAME=procure_user
DB_PASSWORD=procure_pass

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# Generate your own: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=c2VjcmV0LWtleS1mb3ItcHJvY3VyZW1lbnQtc3lzdGVtLWNoYW5nZS1pbi1wcm9k
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_MS=604800000

# ── Mail (Mailtrap sandbox — replace with your credentials) ───
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# ── AWS (leave blank for local dev) ───────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=procure-files
AWS_SES_FROM=noreply@procure.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── App ───────────────────────────────────────────────────────
APP_PROFILE=dev
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200
